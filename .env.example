# Server-only private iCalendar feed for South-View Remember Someone — Birthdays.
# Set this locally in .env.development.local or as a Vercel Secret in production.
# Never use NEXT_PUBLIC_ for this value or commit a populated feed URL.
REMEMBER_BIRTHDAY_FEED_URL=

# Staff access. Password is stored as scrypt salt:hash, never as plaintext.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Private Vercel Blob store connected to this project (OIDC on deployments).
BLOB_STORE_ID=
